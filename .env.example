# Settings for one lab. lab-init.sh copies this file to .env and fills in the
# values it works out itself, which are LAB_URL and IDE_PASSWORD.

# letsencrypt on Heropa. For a test on your own machine use none together
# with LAB_HOST=localhost, which serves plain HTTP. self-signed also exists,
# but browsers then block the guide pane in the editor.
LAB_CERT="letsencrypt"

# Optional address for the Let's Encrypt account.
CERTBOT_EMAIL=""

# The ports nginx publishes on the VM. Change them only for a local test where
# 80 and 443 are taken.
LAB_HTTP_PORT="80"
LAB_HTTPS_PORT="443"
